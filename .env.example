# Client-safe: Vite exposes only variables prefixed VITE_.
VITE_API_BASE_URL=/api/v1
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# FastAPI / Vercel server runtime only. Never put these in VITE_ variables.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_WEB_RISK_API_KEY=
# Keep false while using the zero-fee PhishDestroy + CERT Polska architecture.
# Set true only after a commercial Google Web Risk billing account is active.
ENABLE_GOOGLE_WEB_RISK=false
FREE_WEB_RISK_MONTHLY_BUDGET=100000
# PhishDestroy requires no key. It receives only normalized hostnames, is cached,
# and is globally throttled to respect its public API.
ENABLE_PHISHDESTROY=true
PHISHDESTROY_CACHE_MINUTES=15
PHISHDESTROY_REQUESTS_PER_MINUTE=30
# Optional: register a free PhishTank application key if registrations reopen.
PHISHTANK_APP_KEY=
THREAT_FEED_REFRESH_MINUTES=60
# Per-process API abuse guard. Also configure equivalent limits in your CDN/WAF.
API_RATE_LIMIT_PER_MINUTE=45
API_MAX_REQUEST_BYTES=25000
# Set a long random secret in Vercel/FastAPI production environment variables.
# It is used only to hash client IPs in privacy-safe rate-limit logs.
SECURITY_MONITORING_SALT=change-this-to-a-long-random-production-secret
ALLOWED_ORIGINS=http://localhost:5173
